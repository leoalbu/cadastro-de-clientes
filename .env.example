# ==============================================================
#  Supabase - acesso via API REST (HTTP)
#  1. Copie este arquivo para .env  ->  cp .env.example .env
#  2. Preencha com os valores do SEU projeto:
#     Supabase Dashboard > Project Settings > API
#  O arquivo .env NAO deve ser versionado (ja esta no .gitignore).
# ==============================================================

# URL base do projeto. Ex.: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Endpoint REST = SUPABASE_URL + /rest/v1
SUPABASE_REST_URL=https://SEU-PROJETO.supabase.co/rest/v1

# Chave publica (aparece como "anon" / "public" ou "publishable key").
# E a chave que o app cliente usa nas requisicoes.
SUPABASE_ANON_KEY=cole-aqui-a-sua-anon-key

# Chave secreta (aparece como "service_role" / "secret key").
# Ignora o Row Level Security. NUNCA distribua um app com ela.
# Deixe em branco, a menos que rode scripts administrativos no seu PC.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo de assinatura dos JWT (Project Settings > API > JWT Settings).
# So e necessario se o app for validar/gerar tokens. Opcional.
SUPABASE_JWT_SECRET=

# Nome da tabela usada pelo cadastro de clientes.
SUPABASE_TABLE_CLIENTES=clientes
