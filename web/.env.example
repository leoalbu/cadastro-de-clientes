# Copie para .env.local e preencha (Supabase Dashboard > Project Settings > API).
# Sem prefixo NEXT_PUBLIC_ de propósito: essas variáveis só existem no servidor
# (Server Components / Server Actions), nunca no bundle enviado ao navegador.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-aqui-a-sua-anon-key
SUPABASE_TABLE_CLIENTES=clientes
